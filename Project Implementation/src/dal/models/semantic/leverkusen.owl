  <rdf:Description rdf:about="https://github.com/MeetShah9/CSC-501-Team-Project/leverkusen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Beyond the Scoresheet: Bayer Leverkusen 2023/24 ontology</rdfs:label>
    <dcterms:creator>Meet Hemang Shah; Sakshi Pinkeshkumar Patel; Ayush Bharatbhai Patel</dcterms:creator>
    <dcterms:source rdf:resource="https://github.com/statsbomb/open-data"/>
    <owl:versionInfo>1.0 (CSC 501 Milestone 5, Semantic Web)</owl:versionInfo>
    <rdfs:comment xml:lang="en">Matches, teams, squads and timestamped player events of Bayer Leverkusen's 2023/24 Bundesliga season. Keeps the recorded player-event links explicit: performedBy, intendedFor (the pass's named target, not a guaranteed receipt) and assists (pass -&gt; shot).</rdfs:comment>
  </rdf:Description>
